<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->

<main class="container">

<div class="date-row">
  <form>
    <label for="date">Date:</label>
    <input
      type="date"
      id="date"
      name="date"
      value="<%= defaultDate %>"
    >
  </form>

  <div class="clock" id="clock">
  <span class="number n12">12</span>
  <span class="number n1">1</span>
  <span class="number n2">2</span>
  <span class="number n3">3</span>
  <span class="number n4">4</span>
  <span class="number n5">5</span>
  <span class="number n6">6</span>
  <span class="number n7">7</span>
  <span class="number n8">8</span>
  <span class="number n9">9</span>
  <span class="number n10">10</span>
  <span class="number n11">11</span>

  <div class="hand hour" id="hour"></div>
  <div class="hand minute" id="minute"></div>
  <div class="hand second" id="second"></div>
  <div class="clock-dot"></div>
</div>
 
</div>


<h2 id="hm">
  Login Dashboard
</h2>

<div class="mb-3">
  <strong>Total Logins:</strong>
  <%= totalRecords %>
</div>
<section class="py-5 bg-light border border-black mt-4 mb-4">

  <!-- ======================================================
       FILTERS
       ====================================================== -->

  <form
    method="GET"
    action="/admin/daily-login-report"
    class="mb-4"
  >

    <!-- DATE FILTER -->

    <label for="filter-date">
      Login Date:
    </label>

    <input
      type="date"
      id="filter-date"
      name="date"
      value="<%= selectedDate || '' %>"
    />


   <!-- USER FILTER -->

<label
  for="filter-user"
  class="ms-3"
>
  User:
</label>

<select
  id="filter-user"
  name="user_id"
>

  <option value="">
    All Users
  </option>

  <%
    const userList =
      typeof users !== "undefined" && Array.isArray(users)
        ? users
        : [];
  %>

  <% userList.forEach((user) => { %>

    <option
      value="<%= user.id %>"
      <%= String(user.id) === String(selectedUser || "")
        ? "selected"
        : "" %>
    >

      <%= user.email %>

      <% if (user.first_name || user.last_name) { %>

        -
        <%= user.first_name || "" %>
        <%= user.last_name || "" %>

      <% } %>

    </option>

  <% }); %>

</select>



    <!-- BROWSER TIMEZONE -->

    <input
      type="hidden"
      id="timezone"
      name="timezone"
      value="<%= selectedTimezone || '' %>"
    />


    <!-- FILTER BUTTON -->

    <button
      type="submit"
      class="btn btn-primary ms-2"
    >
      Filter
    </button>


    <!-- CLEAR FILTERS -->

    <a
      href="/admin/daily-login-report"
      class="btn btn-secondary ms-2"
    >
      Clear Filters
    </a>

  </form>


  <!-- ======================================================
       LOGIN REPORT TABLE
       ====================================================== -->

  <div class="table-responsive">

    <table
      class="social-profile-table table table-bordered login-report-table"
    >

      <thead>

        <tr>

          <th>ID</th>

          <th>User ID</th>

          <th>First Name</th>

          <th>Last Name</th>

          <th>Email</th>

          <th>PW Update</th>

          <th>Login</th>

          <th>Logout</th>

          <th>Idle Logout</th>

          <th>Status</th>

          <th>Duration</th>

          <th>Updated At</th>

          <th>Login Count</th>

          <th>Action</th>

        </tr>

      </thead>


      <tbody>

        <% if (loginStats && loginStats.length > 0) { %>

          <% loginStats.forEach((login) => { %>

            <tr>

              <!-- ID -->

              <td data-label="ID">
                <%= login.id %>
              </td>


              <!-- USER ID -->

              <td data-label="User ID">
                <%= login.user_id %>
              </td>


              <!-- FIRST NAME -->

              <td data-label="First Name">
                <%= login.first_name || "" %>
              </td>


              <!-- LAST NAME -->

              <td data-label="Last Name">
                <%= login.last_name || "" %>
              </td>


              <!-- EMAIL -->

              <td data-label="Email">
                <%= login.email || "" %>
              </td>


              <!-- PASSWORD UPDATE -->

              <td data-label="PW Update">
                <%= login.updated_password_date || "" %>
              </td>


              <!-- LOGIN -->

              <td data-label="Login">

                <% if (login.created_at) { %>

                  <span
                    class="local-date-time"
                    data-value="<%= login.created_at.toISOString() %>"
                  ></span>

                <% } else { %>

                  —

                <% } %>

              </td>


              <!-- MANUAL LOGOUT -->

              <td data-label="Logout">

                <% if (login.logout) { %>

                  <span
                    class="local-date-time"
                    data-value="<%= login.logout.toISOString() %>"
                  ></span>

                <% } else { %>

                  <span class="text-muted">
                    —
                  </span>

                <% } %>

              </td>


              <!-- IDLE LOGOUT -->

              <td data-label="Idle Logout">

                <% if (login.idlelogout) { %>

                  <span
                    class="local-date-time"
                    data-value="<%= login.idlelogout.toISOString() %>"
                  ></span>

                <% } else { %>

                  <span class="text-muted">
                    —
                  </span>

                <% } %>

              </td>


              <!-- STATUS -->

              <td data-label="Status">

                <% if (login.session_status === "Logout") { %>

                  <span class="text-success">
                    Logout
                  </span>

                <% } else if (
                  login.session_status === "Idle Logout"
                ) { %>

                  <span class="text-warning">
                    Idle Logout
                  </span>

                <% } else { %>

                  <span class="text-primary">
                    Active
                  </span>

                <% } %>

              </td>


              <!-- DURATION -->

              <td data-label="Duration">

                <% if (
                  login.duration_seconds !== null &&
                  login.duration_seconds !== undefined
                ) { %>

                  <%
                    const totalSeconds =
                      Number(login.duration_seconds);

                    const hours =
                      Math.floor(
                        totalSeconds / 3600
                      );

                    const minutes =
                      Math.floor(
                        (totalSeconds % 3600) / 60
                      );

                    const seconds =
                      totalSeconds % 60;
                  %>

                  <% if (hours > 0) { %>

                    <%= hours %>h

                  <% } %>

                  <% if (
                    minutes > 0 ||
                    hours > 0
                  ) { %>

                    <%= minutes %>m

                  <% } %>

                  <%= seconds %>s

                <% } else { %>

                  <span class="text-muted">
                    —
                  </span>

                <% } %>

              </td>


              <!-- UPDATED AT -->

              <td data-label="Updated At">

                <% if (login.updated_at) { %>

                  <span
                    class="local-date-time"
                    data-value="<%= login.updated_at.toISOString() %>"
                  ></span>

                <% } else { %>

                  —

                <% } %>

              </td>


              <!-- LOGIN COUNT -->

              <td data-label="Login Count">

                <strong>
                  <%= login.login_count %>
                </strong>

              </td>


              <!-- ACTION -->

              <td data-label="Action">

                <form
                  action="/admin/daily-login-report/<%= login.id %>?_method=DELETE"
                  method="POST"
                  onsubmit="return confirm('Delete this login record?');"
                  class="d-inline"
                >

                  <button
                    type="submit"
                    class="btn btn-danger btn-sm"
                  >
                    Delete
                  </button>

                </form>

              </td>

            </tr>

          <% }); %>

        <% } else { %>

          <tr>

            <td
              colspan="14"
              class="text-center"
            >
              No login records found.
            </td>

          </tr>

        <% } %>

      </tbody>

    </table>

  </div>

</section>


<hr>


<!-- ======================================================
     PAGINATION
     ====================================================== -->

<section class="py-5 bg-light border border-black mt-4 mb-4">

  <nav aria-label="Daily login report pagination">

    <ul class="pagination justify-content-center">


      <!-- PREVIOUS -->

      <li
        class="page-item <%= page <= 1 ? 'disabled' : '' %>"
      >

        <% if (page > 1) { %>

          <a
            class="page-link"
            href="/admin/daily-login-report?page=<%= page - 1 %>&limit=<%= limit %><%= selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '' %><%= selectedTimezone ? `&timezone=${encodeURIComponent(selectedTimezone)}` : '' %><%= selectedUser ? `&user_id=${encodeURIComponent(selectedUser)}` : '' %>"
          >
            Previous
          </a>

        <% } else { %>

          <span class="page-link">
            Previous
          </span>

        <% } %>

      </li>


      <!-- PAGE NUMBERS -->

      <% for (
        let i = 1;
        i <= totalPages;
        i++
      ) { %>

        <li
          class="page-item <%= i === page ? 'active' : '' %>"
        >

          <a
            class="page-link"
            href="/admin/daily-login-report?page=<%= i %>&limit=<%= limit %><%= selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '' %><%= selectedTimezone ? `&timezone=${encodeURIComponent(selectedTimezone)}` : '' %><%= selectedUser ? `&user_id=${encodeURIComponent(selectedUser)}` : '' %>"
          >
            <%= i %>
          </a>

        </li>
 
      <% } %>


      <!-- NEXT -->

      <li
        class="page-item <%= page >= totalPages ? 'disabled' : '' %>"
      >

        <% if (page < totalPages) { %>

          <a
            class="page-link"
            href="/admin/daily-login-report?page=<%= page + 1 %>&limit=<%= limit %><%= selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '' %><%= selectedTimezone ? `&timezone=${encodeURIComponent(selectedTimezone)}` : '' %><%= selectedUser ? `&user_id=${encodeURIComponent(selectedUser)}` : '' %>"
          >
            Next
          </a>

        <% } else { %>

          <span class="page-link">
            Next
          </span>

        <% } %>

      </li>

    </ul>

  </nav>

</section>
 

</main>
 <script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
 <script src="/js/clock.js"></script>

<script>
  // =====================================================
  // USER'S LOCAL TIMEZONE
  // =====================================================

  const timezoneInput =
    document.getElementById("timezone");

  if (timezoneInput) {
    timezoneInput.value =
      Intl.DateTimeFormat()
        .resolvedOptions()
        .timeZone;
  }


  // =====================================================
  // DISPLAY TIMESTAMPS IN USER'S LOCAL TIME
  // =====================================================

  function formatLocalDateTime(value) {
    if (!value) return "";

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "";
    }

    return date.toLocaleString(undefined, {
      year: "numeric",
      month: "numeric",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
      second: "2-digit",
    });
  }


  document
    .querySelectorAll(".local-date-time")
    .forEach((element) => {
      element.textContent =
        formatLocalDateTime(
          element.dataset.value
        );
    });
</script>


<%- include("partials/footer.ejs") %>
<!--Remember this include when add a new page-->
