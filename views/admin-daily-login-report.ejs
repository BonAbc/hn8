<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>"  readonly />
  </form>

  <!---->
  <h2 id="hm">Login Dashboard</h2>
  <section class="py-5 bg-light border border-black mt-4 mb-4">
      <form method="GET" action="/admin/daily-login-report" class="mb-4">

  <label for="date">Date:</label>

  <input
    type="date"
    id="date"
    name="date"
    value="<%= selectedDate || '' %>"
  />

  <button type="submit" class="btn btn-primary">
    Filter
  </button>

  <a
    href="/admin/daily-login-report"
    class="btn btn-secondary"
  >
    All Dates
  </a>

</form>
    <table class="social-profile-table table table-bordered login-report-table">



  <thead>
    <tr>
      <th>ID</th>
      <th>User ID</th>
      <th>First Name</th>
      <th>Last Name</th>
      <th>Email</th>
      <th>PW Update</th>
      <th>Login Date</th>
      <th>Login Count</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>

    <% if (loginStats && loginStats.length > 0) { %>

      <% loginStats.forEach((login) => { %>

        <tr>

          <td>
            <%= login.id %>
          </td>

          <td>
            <%= login.user_id %>
          </td>

          <td>
            <%= login.first_name || "" %>
          </td>

          <td>
            <%= login.last_name || "" %>
          </td>

          <td>
            <%= login.email || "" %>
          </td>
           <td>
            <%= login.updated_password_date || "" %>
          </td>

          <td>
            <%= login.login_date %>
          </td>

          <td>
            <strong>
              <%= login.login_count %>
            </strong>
          </td>

          <td>

            <form
              action="/admin/daily-login-report/<%= login.id %>?_method=DELETE"
              method="POST"
              onsubmit="return confirm('Delete this login record?');"
              class="d-inline"
            >

              <button
                type="submit"
                class="btn btn-danger btn-sm"
              >
                Delete
              </button>

            </form>

          </td>

        </tr>
 
      <% }); %>

    <% } else { %>
 
      <tr>
        <td
          colspan="8"
          class="text-center"
        >
          No login records found.
        </td>
      </tr>

    <% } %>

  </tbody>

</table>

  </section>
  <hr>
   <section class="py-5 bg-light border border-black mt-4 mb-4">
<!-- ======================================================
     PAGINATION
     ====================================================== -->



 <nav aria-label="Daily login report pagination">

  <ul class="pagination justify-content-center">

    <!-- Previous -->

    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">

      <% if (page > 1) { %>

        <a
          class="page-link"
          href="/admin/daily-login-report?page=<%= page - 1 %>&limit=<%= limit %><%= selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '' %>"
        >
          Previous
        </a>

      <% } else { %>

        <span class="page-link">
          Previous
        </span>

      <% } %>

    </li>


    <!-- Page Numbers -->

    <% for (let i = 1; i <= totalPages; i++) { %>

      <li class="page-item <%= i === page ? 'active' : '' %>">

        <a
          class="page-link"
          href="/admin/daily-login-report?page=<%= i %>&limit=<%= limit %><%= selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '' %>"
        >
          <%= i %>
        </a>

      </li>

    <% } %>


    <!-- Next -->

    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">

      <% if (page < totalPages) { %>

        <a
          class="page-link"
          href="/admin/daily-login-report?page=<%= page + 1 %>&limit=<%= limit %><%= selectedDate ? `&date=${encodeURIComponent(selectedDate)}` : '' %>"
        >
          Next
        </a>

      <% } else { %>

        <span class="page-link">
          Next
        </span>

      <% } %>

    </li>

  </ul>

</nav>




   </section>
 
  <!--👇👆👆👇👆👇-->
  <!--👇👆👆👇👆👇-->
  
  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>

<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
