<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <%
  const reportDate =
    typeof selectedDate !== "undefined"
      ? selectedDate
      : "";
%>

<form>
  <label for="current-date">Date:</label>

  <input
    type="date"
    id="current-date"
    name="current-date"
    value="<%= defaultDate %>"
    readonly
  />
</form>

<h2 id="hm">Login Dashboard</h2>

<section class="py-5 bg-light border border-black mt-4 mb-4">

  <!-- ======================================================
       DATE FILTER
       ====================================================== -->

  <form
    method="GET"
    action="/admin/daily-login-report"
    class="mb-4"
  >

    <label for="filter-date">Date:</label>

    <input
      type="date"
      id="filter-date"
      name="date"
      value="<%= reportDate %>"
    />

    <button
      type="submit"
      class="btn btn-primary"
    >
      Filter
    </button>

    <a
      href="/admin/daily-login-report"
      class="btn btn-secondary"
    >
      All Dates
    </a>

  </form>


  <!-- ======================================================
       LOGIN REPORT TABLE
       ====================================================== -->

  <div class="table-responsive">

    <table
      class="social-profile-table table table-bordered login-report-table"
    >

      <thead>
        <tr>
          <th>ID</th>
          <th>User ID</th>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Email</th>
          <th>PW Update</th>
          <th>Login Date</th>
          <th>Login Count</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>

        <% if (loginStats && loginStats.length > 0) { %>

          <% loginStats.forEach((login) => { %>

            <tr>

              <td data-label="ID">
                <%= login.id %>
              </td>

              <td data-label="User ID">
                <%= login.user_id %>
              </td>

              <td data-label="First Name">
                <%= login.first_name || "" %>
              </td>

              <td data-label="Last Name">
                <%= login.last_name || "" %>
              </td>

              <td data-label="Email">
                <%= login.email || "" %>
              </td>

              <td data-label="PW Update">
                <%= login.updated_password_date || "" %>
              </td>

              <td data-label="Login Date">
                <%= login.login_date %>
              </td>

              <td data-label="Login Count">
                <strong>
                  <%= login.login_count %>
                </strong>
              </td>

              <td data-label="Action">

                <form
                  action="/admin/daily-login-report/<%= login.id %>?_method=DELETE"
                  method="POST"
                  onsubmit="return confirm('Delete this login record?');"
                  class="d-inline"
                >

                  <button
                    type="submit"
                    class="btn btn-danger btn-sm"
                  >
                    Delete
                  </button>

                </form>

              </td>

            </tr>

          <% }); %>

        <% } else { %>

          <tr>
            <td
              colspan="9"
              class="text-center"
            >
              No login records found.
            </td>
          </tr>

        <% } %>

      </tbody>

    </table>

  </div>

</section>


<hr>


<!-- ======================================================
     PAGINATION
     ====================================================== -->

<section class="py-5 bg-light border border-black mt-4 mb-4">

  <nav aria-label="Daily login report pagination">

    <ul class="pagination justify-content-center">

      <!-- ==================================================
           PREVIOUS
           ================================================== -->

      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">

        <% if (page > 1) { %>

          <a
            class="page-link"
            href="/admin/daily-login-report?page=<%= page - 1 %>&limit=<%= limit %><%= reportDate ? `&date=${encodeURIComponent(reportDate)}` : '' %>"
          >
            Previous
          </a>

        <% } else { %>

          <span class="page-link">
            Previous
          </span>

        <% } %>

      </li>


      <!-- ==================================================
           PAGE NUMBERS
           ================================================== -->

      <% for (let i = 1; i <= totalPages; i++) { %>

        <li class="page-item <%= i === page ? 'active' : '' %>">

          <a
            class="page-link"
            href="/admin/daily-login-report?page=<%= i %>&limit=<%= limit %><%= reportDate ? `&date=${encodeURIComponent(reportDate)}` : '' %>"
          >
            <%= i %>
          </a>

        </li>

      <% } %>


      <!-- ==================================================
           NEXT
           ================================================== -->

      <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">

        <% if (page < totalPages) { %>

          <a
            class="page-link"
            href="/admin/daily-login-report?page=<%= page + 1 %>&limit=<%= limit %><%= reportDate ? `&date=${encodeURIComponent(reportDate)}` : '' %>"
          >
            Next
          </a>

        <% } else { %>

          <span class="page-link">
            Next
          </span>

        <% } %>

      </li>

    </ul>

  </nav>

</section>

  <!--👇👆👆👇👆👇-->
  <!--👇👆👆👇👆👇-->
  
  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>

<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
