<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
    <div class="date-row">
    <form>
      <label for="date">Date:</label>
      <input type="date" id="date" name="date" value="<%= defaultDate %>" />
    </form>

    <div class="clock" id="clock">
      <span class="number n12">12</span>
      <span class="number n1">1</span>
      <span class="number n2">2</span>
      <span class="number n3">3</span>
      <span class="number n4">4</span>
      <span class="number n5">5</span>
      <span class="number n6">6</span>
      <span class="number n7">7</span>
      <span class="number n8">8</span>
      <span class="number n9">9</span>
      <span class="number n10">10</span>
      <span class="number n11">11</span>

      <div class="hand hour" id="hour"></div>
      <div class="hand minute" id="minute"></div>
      <div class="hand second" id="second"></div>
      <div class="clock-dot"></div>
    </div>
  </div>
  <br />
  <!---->
  <h2 id="hm">Payroll</h2>

  <!---->
  <!--Add for fun-->
  <div class="apd">
    <div class="card" style="width: 18rem">
      <img src="/images/hncal.PNG" class="card-img-top" alt="Calculator" />

      <div class="card-body">
        <h5 class="card-title">Calculator</h5>
        <p class="card-text"></p>
        <a id="m1" href="#" class="btn btn-primary">Accurate</a>
      </div>
    </div>

    <div class="card" style="width: 18rem">
      <img
        src="/images/Database-fill-check.PNG"
        class="card-img-top"
        alt="Database Picture"
      />
      <div class="card-body">
        <h5 class="card-title">Database</h5>
        <p class="card-text"></p>
        <a id="m5" href="#" class="btn btn-primary">Consistent</a>
      </div>
    </div>

    <div class="card" style="width: 18rem">
      <img src="/images/hnfolder.PNG" class="card-img-top" alt="Folder" />
      <div class="card-body">
        <h5 class="card-title">Folder</h5>
        <p class="card-text"></p>
        <a id="m2" href="#" class="btn btn-primary">Organized</a>
      </div>
    </div>
  </div>

  <!---->
  <h2>Overview: Tax Year 2025</h2>
  <!---->

  <h5 class="cvla" style="color: green"><u>For references only</u></h5>
  <!---->
  <div class="apt">
    <!---->

    <!---->
    <!--Add table-->
    <!-- Bootstrap container: adds left/right padding and centers content -->

    <div class="container-fluid mt-0">
      <div class="card shadow">
        <!-- Card header: styled with background color and text color -->
        <div class="card-header bg-success text-warning">
          <h4 class="mb-0">Key Updates: New Tax Provisions for 2025</h4>
          <!-- Table title -->
        </div>
        <div class="card-body p-0">
          <div
            class="table-responsive"
            style="max-height: 400px; overflow-y: auto"
          >
            <table class="table hover">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <!-- Table header field 1-->
                  <th scope="col">Effective Years</th>
                  <th scope="col">Items</th>
                  <th scope="col">Summary</th>
                  <th scope="col">Notes</th>
                  <!--Add column header above and Add column content below-->
                </tr>
              </thead>

              <tbody>
                <!-- Check if taxData exists and has rows -->
                <% if (prs && prs.length > 0) { %>
                <!-- Loop over each row in taxData using forEach -->
                <% prs.forEach((row,index)=> { %>

                <tr>
                  <th scope="row"><%= index + 1 %></th>

                  <td><%= row.eed %></td>
                  <td><%= row.nnb %></td>
                  <td><%= row.ccr %></td>
                  <td><%= row.note %></td>
                </tr>
                <% }) %> <% } else { %>
                <tr>
                  <td colspan="6" class="text-muted">No tax data available.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <br />
      <p>Sources: The IRS.</p>
    </div>
    <a href="/mortgage">Mortgage Calculator</a>
  </div>
  <!---->
  <!---->
  <!---->
  <h5>Turning Numbers into Better Decisions.</h5>
</main>
<!---->
<script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
