<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main>
  <!---->
  <div class="date-row">
    <form>
      <label for="date">Date:</label>
      <input type="date" id="date" name="date" value="<%= defaultDate %>" />
    </form>

    <div class="clock" id="clock">
      <span class="number n12">12</span>
      <span class="number n1">1</span>
      <span class="number n2">2</span>
      <span class="number n3">3</span>
      <span class="number n4">4</span>
      <span class="number n5">5</span>
      <span class="number n6">6</span>
      <span class="number n7">7</span>
      <span class="number n8">8</span>
      <span class="number n9">9</span>
      <span class="number n10">10</span>
      <span class="number n11">11</span>

      <div class="hand hour" id="hour"></div>
      <div class="hand minute" id="minute"></div>
      <div class="hand second" id="second"></div>
      <div class="clock-dot"></div>
    </div>
  </div>
  <br />
  <!---->

  <h1 class="cal1">Calculator</h1>

  <div class="container">
    <div class="calculator-wraper">
      <!-- Div 1: First Number Input -->
      <div class="calc-blocks">
        <input type="text" id="num1" placeholder="Enter first number" />
      </div>

      <!-- Div 2: Operator Selection -->
      <div class="calc-blocks">
        <select id="operator">
          <option value="">Select Operation</option>
          <option value="+">+</option>
          <option value="-">−</option>
          <option value="*">×</option>
          <option value="/">÷</option>
          <option value="^">^ (power)</option>
        </select>
      </div>

      <!-- Div 3: Second Number Input -->
      <div class="calc-blocks">
        <input type="text" id="num2" placeholder="Enter second number" />
      </div>

      <!-- Div 4: Calculate Button -->
      <div class="calc-blocks">
        <!--  <button onclick="calculate()">Calculate</button> Original-->
        <button id="calculateBtn">Calculate</button>
      </div>
      <div class="calc-blocks">
        <button id="resetBtn">Reset</button>
      </div>

      <!-- Div 5: Result Input -->
      <div class="calc-blocks">
        <input type="text" id="result" placeholder="Result" />
      </div>
    </div>
    <!--Add paper for remember for next calculator-->
    <div class="paper">
      <h5>Notes for the calculation</h5>
      <textarea>Just notes: </textarea>

      <!--Refer to CSS , so it is a form, without CSS it does not look right-->
    </div>
  </div>
  <!--Add paper for remember for next calculator-->
  <h5>Turning Numbers into Better Decisions.</h5>
</main>

<!-- Link external JS -->
<script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
<script src="/js/clock.js"></script>
<script src="/js/cal.js"></script>
<!-- Link external JS end -->

<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
