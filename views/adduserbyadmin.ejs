            Username
          </label>
 
          <input
            type="text"
            id="username"
            name="email"
            class="form-control rounded-pill border-dark"
            required
            autocomplete="username"
          />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label fw-semibold">
            Password
          </label>

          <div class="custom-input-group">
            <input
              type="password"
              id="password"
              name="password" 
              class="form-control"
              required
              autocomplete="current-password"
            />
            <button
              type="button"
              id="togglePassword"
              class="toggle-btn"
              aria-label="Toggle password visibility"
            >
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>
         <!-- NEW: GROUP ID -->
