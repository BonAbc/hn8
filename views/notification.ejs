<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>
 
  <!---->
  <h2 id="hm">Hoa Mai</h2>
  <br>
  <section class="py-5 bg-light border border-black mt-4 mb-4">

  <div class="container">

    <div class="social-notifications">

      <!-- ======================================================
           NOTIFICATION COUNT
      ======================================================= -->

      <div class="social-notification-count">

        Notifications:
        <%= notifications ? notifications.length : 0 %>

      </div>


      <!-- ======================================================
           NOTIFICATIONS
      ======================================================= -->

      <% if (notifications && notifications.length > 0) { %>

        <% notifications.forEach(function(notification) { %>

        <a
  href="/notification/<%= notification.id %>"
  class="social-notification"
  style="display:block; text-decoration:none;"
>


            <div class="social-notification-content">

              <%= notification.message %>

              <% if (notification.actor_email) { %>

                — <%= notification.actor_email %>

              <% } %>

            </div>


            <div class="social-notification-date">

              <%= notification.created_at
                ? new Date(notification.created_at).toLocaleString()
                : ""
              %>

            </div>

          </a>

        <% }); %>

      <% } else { %>

        <div class="social-notification">

          <div class="social-notification-content">

            No notifications.

          </div>

        </div>

      <% } %>

    </div>

  </div>

</section>

  <!-- ============================================================
     SOCIAL NOTIFICATIONS
============================================================= -->




  <section class="py-5 bg-light border border-black mt-4 mb-4"></section>
  <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid">
      <!--👇👆👆👇👆👇-->
      <button type="submit" class="btn btn-primary w-auto">Good Format</button>
      <!--👇👆👆👇👆👇-->
    </div>
  </section>
  <!---->
