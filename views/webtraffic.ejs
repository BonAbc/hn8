
<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>

  <!---->
  <!---->
  <h2 id="hm">Hoa Mai</h2>
  <!--👇👆👆👇👆👇--> 
  <!---->
  <!--👇👆👆👇👆👇-->
  <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid">
      <h2>Web Support</h2>
      <h4>
    Total Visits:
    <span class="badge bg-primary">
        <%= total %>
    </span>
</h4>
     <form
  action="/web/traffic/test/delete-selected"
  method="POST"
  onsubmit="return confirmBulkDelete();"
>

  <input type="hidden" name="page" value="<%= page %>">

  <div class="mb-2">
    <button
      type="submit"
      class="btn btn-danger btn-sm rounded-0"
    >
      Delete Selected
    </button>
  </div>

  <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th>
          <input
            type="checkbox"
            id="selectAll"
            onclick="toggleAll(this)"
          >
        </th>
        <th>ID</th>
        <th>IP</th>
        <th>Country</th>
        <th>City</th>
        <th>Timezone</th>
        <th>Page</th>
        <th>Time</th>
      </tr>
    </thead>

    <tbody id="list">

      <% visitors.forEach(visitor => { %>

        <tr>
          <td>
            <input
              type="checkbox"
              name="ids"
              value="<%= visitor.id %>"
              class="visitor-checkbox"
            >
          </td>

          <td><%= visitor.id %></td>
          <td><%= visitor.ip_address %></td>
          <td><%= visitor.country %></td>
          <td><%= visitor.city %></td>
          <td><%= visitor.timezone %></td>
          <td><%= visitor.page %></td>
          <td><%= visitor.created_at %></td>
        </tr>

      <% }) %>

    </tbody>
  </table>

</form>
<div style="margin-top:20px;">
<!-- PAGINATION -->
<nav>
  <ul class="pagination justify-content-center">

    <!-- First -->
    <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
      <a class="page-link rounded-0" href="/web/traffic/test?page=1">
        First
      </a>
    </li>

    <!-- Previous -->
    <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
      <a class="page-link rounded-0" href="/web/traffice/test?page=<%= page - 1 %>">
        Previous
      </a>
    </li>

    <!-- Page Numbers -->
    <%
      let start = Math.max(1, page - 2);
      let end = Math.min(totalPages, page + 2);

      if (start > 1) {
    %>

      <li class="page-item">
        <a class="page-link rounded-0" href="/web/traffic/test?page=1">1</a>
      </li>

      <% if (start > 2) { %>
        <li class="page-item disabled">
          <span class="page-link rounded-0">...</span>
        </li>
      <% } %>

    <% } %>

    <% for (let i = start; i <= end; i++) { %>
      <li class="page-item <%= i === page ? 'active' : '' %>">
        <a class="page-link rounded-0" href="/web/traffic/test?page=<%= i %>">
          <%= i %>
        </a>
      </li>
    <% } %>

    <% if (end < totalPages) { %>

      <% if (end < totalPages - 1) { %>
        <li class="page-item disabled">
          <span class="page-link rounded-0">...</span>
        </li>
      <% } %>

      <li class="page-item">
        <a class="page-link rounded-0" href="/web/traffic/test?page=<%= totalPages %>">
          <%= totalPages %>
        </a>
      </li>

    <% } %>

    <!-- Next -->
    <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
      <a class="page-link rounded-0" href="/web/traffic/test?page=<%= page + 1 %>">
        Next
      </a>
    </li>

    <!-- Last -->
    <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
      <a class="page-link rounded-0" href="/web/traffic/test?page=<%= totalPages %>">
        Last
      </a>
    </li> 

  </ul>

  <div class="text-center mt-2">
    Page <strong><%= page %></strong> of <strong><%= totalPages %></strong>
  </div>
</nav>
<!-- PAGINATION -->
</div>
    </div>
  </section>
  <!--👇👆👆👇👆👇-->
   
  <!--👇👆👆👇👆👇-->
  <!--👇👆👆👇👆👇-->
  <!---->
  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>

<!--👇👆👆👇👆👇-->
<!-- Link external JS -->
<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

// (data):object receive from front js
socket.on("new-visitor", (data) => {

    const table = document.getElementById("list");

    table.innerHTML =
    `
    <tr>
        <td>NEW</td>
        <td>${data.ip || ""}</td>
        <td>${data.page}</td>
        <td>${data.time}</td> 
    </tr>
    `
    + table.innerHTML;

});

</script>
<script>

function toggleAll(source) {
  const checkboxes = document.querySelectorAll(".visitor-checkbox");

  checkboxes.forEach(checkbox => {
    checkbox.checked = source.checked;
  });
}

function confirmBulkDelete() {
  const selected = document.querySelectorAll(
    ".visitor-checkbox:checked"
  );

  if (selected.length === 0) {
    alert("Please select at least one visitor.");
    return false;
  }

  return confirm(
    `Delete ${selected.length} selected visitor record(s)?`
  );
}

</script>
<!-- Link external JS end -->
