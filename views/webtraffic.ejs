  <!--👇👆👆👇👆👇-->
  <section class="web-traffic-page py-4 bg-light border border-black mt-4 mb-4">

  <div class="container-fluid">

    <form
  action="/web/traffic/test/delete-selected"
  method="POST"
  onsubmit="return confirmBulkDelete();"
>

  <input
    type="hidden"
    name="page"
    value="<%= page %>"
  >

  <!-- Keep current filters -->
  <input
    type="hidden"
    name="ip"
    value="<%= ip || '' %>"
  >

  <input
    type="hidden"
    name="country"
    value="<%= country || '' %>"
  >

  <input
    type="hidden"
    name="status"
    value="<%= status || '' %>"
  >

  <input
    type="hidden"
    name="date"
    value="<%= date || '' %>"
  >

  <button
    type="submit"
    class="btn btn-danger btn-sm rounded-0 mb-3"
  >
    Delete Selected
  </button>


  <div class="table-wrapper">

    <table
      class="table table-striped table-hover table-bordered visitor-table"
    >

      <thead>

        <tr>

          <!-- SELECT ALL -->
          <th>

            <label
              for="select-all"
              style="cursor: pointer;"
            >
              <input
                type="checkbox"
                id="select-all"
                onchange="toggleAll(this)"
              >

              Select All
            </label>

          </th>

          <th>ID</th>
          <th>IP</th>
          <th>Country</th>
          <th>City</th>
          <th>Timezone</th>
          <th>Page</th>
          <th>Status</th>
          <th>Time</th>

        </tr>

      </thead>


      <tbody id="list">

        <% visitors.forEach(visitor => { %>

          <tr>

            <!-- SELECT -->
            <td data-label="Select">

              <input
                type="checkbox"
                name="ids"
                value="<%= visitor.id %>"
                class="visitor-checkbox"
              >

            </td>


            <!-- ID -->
            <td data-label="ID">
              <%= visitor.id %>
            </td>


            <!-- IP -->
            <td data-label="IP">
              <%= visitor.ip_address %>
            </td>


            <!-- COUNTRY -->
            <td data-label="Country">
              <%= visitor.country %>
            </td>


            <!-- CITY -->
            <td data-label="City">
              <%= visitor.city %>
            </td>


            <!-- TIMEZONE -->
            <td data-label="Timezone">
              <%= visitor.timezone %>
            </td>


            <!-- PAGE -->
            <td data-label="Page">
              <%= visitor.page %>
            </td>


            <!-- STATUS -->
            <td data-label="Status">
              <%= visitor.status %>
            </td>


            <!-- TIME -->
            <td data-label="Time">
              <%= formatChicagoDateTime(visitor.created_at) %>
            </td>

          </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

</form>

  </div>
</section>
