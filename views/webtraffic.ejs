  <!--👇👆👆👇👆👇-->
    <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid">
      <h2>Web Support</h2>
      <h4>
    Total Visits:
    <span class="badge bg-primary">
        <%= total %>
    </span>
</h4>
