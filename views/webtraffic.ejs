<%- include("partials/header.ejs") %>

<main class="container">

  <form>
    <label for="date">Date:</label>
    <input
      type="date"
      id="date"
      name="date"
      value="<%= defaultDate %>"
    />
  </form>

  <h2 id="hm">Hoa Mai</h2>

  <!-- FILTERS -->
  <section class="py-4 bg-light border border-black mt-4 mb-4">

    <div class="container-fluid">

      <h2>Filter Web Traffic</h2>

      <form
        action="/web/traffic/test"
        method="GET"
        class="row g-3"
      >

        <!-- VISITOR IP -->
        <div class="col-md-3">

          <label
            for="ip"
            class="form-label"
          >
            Visitor IP
          </label>

          <input
            type="text"
            id="ip"
            name="ip"
            class="form-control"
            placeholder="e.g. 98.123.123.123"
            value="<%= ip || '' %>"
          >

        </div>


        <!-- COUNTRY -->
        <div class="col-md-3">

          <label
            for="country"
            class="form-label"
          >
            Country
          </label>

          <select
            id="country"
            name="country"
            class="form-select"
          >

            <option value="">
              All Countries
            </option>

            <% countries.forEach(item => { %>

              <option
                value="<%= item %>"
                <%= country === item ? "selected" : "" %>
              >
                <%= item %>
              </option>

            <% }) %>

          </select>

        </div>


        <!-- STATUS -->
        <div class="col-md-3">

          <label
            for="status"
            class="form-label"
          >
            Status
          </label>

          <select
            id="status"
            name="status"
            class="form-select"
          >

            <option value="">
              All Statuses
            </option>

            <% statuses.forEach(item => { %>

              <option
                value="<%= item %>"
                <%= String(status) === String(item)
                  ? "selected"
                  : "" %>
              >
                <%= item %>
              </option>

            <% }) %>

          </select>

        </div>


        <!-- DATE -->
        <div class="col-md-3">

          <label
            for="filter-date"
            class="form-label"
          >
            Date
          </label>

          <input
            type="date"
            id="filter-date"
            name="date"
            class="form-control"
            value="<%= date || '' %>"
          >

        </div>


        <!-- BUTTONS -->
        <div class="col-12">

          <button
            type="submit"
            class="btn btn-primary rounded-0"
          >
            Show
          </button>

          <a
            href="/web/traffic/test"
            class="btn btn-secondary rounded-0"
          >
            Clear
          </a>

        </div>

      </form>

    </div>

  </section>


  <!-- TOTAL -->
  <section class="py-5 bg-light border border-black mt-4 mb-4">

    <div class="container-fluid">

      <h2>Web Support</h2>

      <h4>
        Total Visits:

        <span class="badge bg-primary">
          <%= total %>
        </span>
      </h4>

    </div>

  </section>


  <!-- TRAFFIC TABLE -->
  <section class="web-traffic-page py-4 bg-light border border-black mt-4 mb-4">

    <div class="container-fluid">

      <form
        action="/web/traffic/test/delete-selected"
        method="POST"
        onsubmit="return confirmBulkDelete();"
      >

        <input
          type="hidden"
          name="page"
          value="<%= page %>"
        >

        <!-- KEEP FILTERS -->

        <input
          type="hidden"
          name="ip"
          value="<%= ip || '' %>"
        >

        <input
          type="hidden"
          name="country"
          value="<%= country || '' %>"
        >

        <input
          type="hidden"
          name="status"
          value="<%= status || '' %>"
        >

        <input
          type="hidden"
          name="date"
          value="<%= date || '' %>"
        >


        <button
          type="submit"
          class="btn btn-danger btn-sm rounded-0 mb-3"
        >
          Delete Selected
        </button>
           <!-- SELECT ALL -->
<div class="select-all-wrapper mb-3">

  <label
    for="select-all"
    style="cursor: pointer;"
  >

    <input
      type="checkbox"
      id="select-all"
    >

    Select All

  </label>

</div>

        <div class="table-wrapper">


          <table
            class="table table-striped table-hover table-bordered visitor-table"
          >

            <thead>

              <tr>

                <!-- SELECT ALL -->
                

                <th>Select</th>
                <th>ID</th>

                <!-- ACTUAL VISITOR -->
                <th>Visitor IP</th>

                <!-- CLOUDFLARE -->
                <th>Cloudflare IP</th>

                <th>Country</th>

                <th>City</th>

                <th>Timezone</th>

                <th>Page</th>

                <th>Status</th>

                <th>Time</th>

              </tr>

            </thead>


            <tbody id="list">

              <% if (visitors && visitors.length > 0) { %>

                <% visitors.forEach(visitor => { %>

                  <tr>

                    <!-- SELECT -->
                    <td data-label="Select">

                      <input
                        type="checkbox"
                        name="ids"
                        value="<%= visitor.id %>"
                        class="visitor-checkbox"
                      >

                    </td>


                    <!-- ID -->
                    <td data-label="ID">
                      <%= visitor.id %>
                    </td>


                    <!-- ACTUAL VISITOR IP -->
                    <td data-label="Visitor IP">

                      <%= visitor.visitor_ip || "Unknown" %>

                    </td>


                    <!-- CLOUDFLARE IP -->
                    <td data-label="Cloudflare IP">

                      <%= visitor.ip_address || "Unknown" %>

                    </td>


                    <!-- COUNTRY -->
                    <td data-label="Country">

                      <%= visitor.country || "Unknown" %>

                    </td>


                    <!-- CITY -->
                    <td data-label="City">

                      <%= visitor.city || "Unknown" %>

                    </td>


                    <!-- TIMEZONE -->
                    <td data-label="Timezone">

                      <%= visitor.timezone || "Unknown" %>

                    </td>
 

                    <!-- PAGE -->
                    <td data-label="Page">

                      <%= visitor.page || "Unknown" %>

                    </td>


                    <!-- STATUS -->
                    <td data-label="Status">

                      <%= visitor.status ?? "Unknown" %>

                    </td>


                    <!-- TIME -->
                    <td data-label="Time">

                      <% if (visitor.created_at) { %>

                        <%= formatChicagoDateTime(visitor.created_at) %>

                      <% } else { %>

                        Unknown

                      <% } %>

                    </td>

                  </tr>

                <% }) %>

              <% } else { %>

                <tr>

                  <td
                    colspan="10"
                    class="text-center"
                  >
                    No traffic found.
                  </td>

                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </form>

    </div>

  </section>


  <!-- PAGINATION -->
  <section class="py-5 bg-light border border-black mt-4 mb-4">

    <nav
      class="social-search-pagination"
      aria-label="Search results pagination"
    >

      <%
        const makePageUrl = (pageNumber) => {
          const params = new URLSearchParams();

          params.set("page", pageNumber);

          if (ip) {
            params.set("ip", ip);
          }

          if (country) {
            params.set("country", country);
          }

          if (status) {
            params.set("status", status);
          }

          if (date) {
            params.set("date", date);
          }

          return `/web/traffic/test?${params.toString()}`;
        };
      %>


      <!-- PREVIOUS -->

      <% if (page > 1) { %>

        <a
          href="<%= makePageUrl(page - 1) %>"
          class="social-search-page-button social-search-page-prev"
        >
          ← Previous
        </a>

      <% } else { %>

        <span
          class="social-search-page-button social-search-page-prev disabled"
        >
          ← Previous
        </span>

      <% } %>


      <!-- PAGE NUMBERS -->

      <div class="social-search-page-numbers">

        <%
          let start = Math.max(1, page - 2);
          let end = Math.min(totalPages, page + 2);

          if (start > 1) {
        %>

          <a
            href="<%= makePageUrl(1) %>"
            class="social-search-page-button social-search-page-number"
            aria-label="Page 1"
          >
            1
          </a>

          <% if (start > 2) { %>

            <span
              class="social-search-page-button social-search-page-number disabled"
            >
              ...
            </span>

          <% } %>

        <% } %>


        <% for (let i = start; i <= end; i++) { %>

          <a
            href="<%= makePageUrl(i) %>"
            class="social-search-page-button social-search-page-number <%= i === page ? 'active' : '' %>"
            aria-label="Page <%= i %>"
            <%= i === page ? 'aria-current="page"' : '' %>
          >
            <%= i %>
          </a>

        <% } %>


        <% if (end < totalPages) { %>

          <% if (end < totalPages - 1) { %>

            <span
              class="social-search-page-button social-search-page-number disabled"
            >
              ...
            </span>

          <% } %>


          <a
            href="<%= makePageUrl(totalPages) %>"
            class="social-search-page-button social-search-page-number"
            aria-label="Page <%= totalPages %>"
          >
            <%= totalPages %>
          </a>

        <% } %>

      </div>


      <!-- NEXT -->

      <% if (page < totalPages) { %>

        <a
          href="<%= makePageUrl(page + 1) %>"
          class="social-search-page-button social-search-page-next"
        >
          Next →
        </a>

      <% } else { %>

        <span
          class="social-search-page-button social-search-page-next disabled"
        >
          Next →
        </span>

      <% } %>


      <!-- LAST -->

      <% if (page < totalPages) { %>

        <a
          href="<%= makePageUrl(totalPages) %>"
          class="social-search-page-button social-search-page-next"
        >
          Last →
        </a>

      <% } else { %>

        <span
          class="social-search-page-button social-search-page-next disabled"
        >
          Last →
        </span>

      <% } %>

    </nav>

  </section>

</main>


<script src="/socket.io/socket.io.js"></script>

<script src="/js/webtraffics.js"></script>

<%- include("partials/footer.ejs") %>