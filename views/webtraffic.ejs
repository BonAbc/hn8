   <section class="py-4 bg-light border border-black mt-4 mb-4">

  <div class="container-fluid">

    <h2>Filter Web Traffic</h2>

    <form
      action="/web/traffic/test"
      method="GET"
      class="row g-3"
    >

      <!-- IP -->
      <div class="col-md-3">

        <label
          for="ip"
          class="form-label"
        >
          IP Address
        </label>

        <input
          type="text"
          id="ip"
          name="ip"
          class="form-control"
          placeholder="e.g. 192.168.1.1"
          value="<%= ip || '' %>"
        >

      </div>


      <!-- COUNTRY -->
      <div class="col-md-3">

        <label
          for="country"
          class="form-label"
        >
          Country
        </label>

        <select
          id="country"
          name="country"
          class="form-select"
        >

          <option value="">
            All Countries
          </option>

          <% countries.forEach(item => { %>

            <option
              value="<%= item %>"
              <%= country === item ? "selected" : "" %>
            >
              <%= item %>
            </option>

          <% }) %>

        </select>

      </div>


      <!-- STATUS -->
      <div class="col-md-3">

        <label
          for="status"
          class="form-label"
        >
          Status
        </label>

        <select
          id="status"
          name="status"
          class="form-select"
        >

          <option value="">
            All Statuses
          </option>

          <% statuses.forEach(item => { %>

            <option
              value="<%= item %>"
              <%= String(status) === String(item)
                ? "selected"
                : "" %>
            >
              <%= item %>
            </option>

          <% }) %>

        </select>

      </div>


      <!-- DATE -->
      <div class="col-md-3">

        <label
          for="filter-date"
          class="form-label"
        >
          Date
        </label>

        <input
          type="date"
          id="filter-date"
          name="date"
          class="form-control"
          value="<%= date || '' %>"
        >

      </div>


      <!-- BUTTONS -->
      <div class="col-12">

        <button
          type="submit"
          class="btn btn-primary rounded-0"
        >
          Show
        </button>

        <a
          href="/web/traffic/test"
          class="btn btn-secondary rounded-0"
        >
          Clear
        </a>

      </div>

    </form>

  </div>

</section>

  <!---->
  <!--👇👆👆👇👆👇-->
