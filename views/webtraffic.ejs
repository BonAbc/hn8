  <!--👇👆👆👇👆👇-->
  <section class="web-traffic-page py-4 bg-light border border-black mt-4 mb-4">

  <div class="container-fluid">

    <form
      action="/web/traffic/test/delete-selected"
      method="POST"
      onsubmit="return confirmBulkDelete();"
    >

      <input type="hidden" name="page" value="<%= page %>">

      <button
        type="submit"
        class="btn btn-danger btn-sm rounded-0 mb-3"
      >
        Delete Selected
      </button>

      <div class="table-wrapper">

        <table class="table table-striped table-hover table-bordered visitor-table">

          <thead>
            <tr>
              <th>Select</th>
              <th>ID</th>
              <th>IP</th>
              <th>Country</th>
              <th>City</th>
              <th>Timezone</th>
              <th>Page</th>
              <th>Time</th>
            </tr>
          </thead>

          <tbody id="list">

            <% visitors.forEach(visitor => { %>

              <tr>

                <td data-label="Select">
                  <input
                    type="checkbox"
                    name="ids"
                    value="<%= visitor.id %>"
                    class="visitor-checkbox"
                  >
                </td>

                <td data-label="ID">
                  <%= visitor.id %>
                </td>

                <td data-label="IP">
                  <%= visitor.ip_address %>
                </td>

                <td data-label="Country">
                  <%= visitor.country %>
                </td>

                <td data-label="City">
                  <%= visitor.city %>
                </td>

                <td data-label="Timezone">
                  <%= visitor.timezone %>
                </td>

                <td data-label="Page">
                  <%= visitor.page %>
                </td>
                 <td><%= visitor.created_at %></td>   

              </tr>

            <% }) %>
 
          </tbody>

        </table>

      </div>

    </form>

  </div>
</section>
  <!--👇👆👆👇👆👇--> 
  <!---->
  <!--👇👆👆👇👆👇-->
 <!-- PAGINATION -->
  <section class="py-5 bg-light border border-black mt-4 mb-4"> 
   
      
<nav
  class="social-search-pagination "
  aria-label="Search results pagination"
>

  <!-- PREVIOUS -->

  <% if (page > 1) { %>

    <a
      href="/web/traffic/test?page=<%= page - 1 %>"
      class="social-search-page-button social-search-page-prev"
    >
      ← Previous
    </a>

  <% } else { %>

    <span
      class="social-search-page-button social-search-page-prev disabled"
    >
      ← Previous
    </span>

  <% } %>


  <!-- NUMBERED PAGES -->

  <div class="social-search-page-numbers">

    <%
      let start = Math.max(1, page - 2);
      let end = Math.min(totalPages, page + 2);

      if (start > 1) {
    %>

      <a
        href="/web/traffic/test?page=1"
        class="social-search-page-button social-search-page-number"
        aria-label="Page 1"
      >
        1
      </a>

      <% if (start > 2) { %>

        <span
          class="social-search-page-button social-search-page-number disabled"
        >
          ...
        </span>

      <% } %>

    <% } %>


    <% for (let i = start; i <= end; i++) { %>

      <a
        href="/web/traffic/test?page=<%= i %>"
        class="social-search-page-button social-search-page-number <%= i === page ? 'active' : '' %>"
        aria-label="Page <%= i %>"
        <%= i === page ? 'aria-current="page"' : '' %>
      >
        <%= i %>
      </a>

    <% } %>


    <% if (end < totalPages) { %>

      <% if (end < totalPages - 1) { %>

        <span
          class="social-search-page-button social-search-page-number disabled"
        >
          ...
        </span>

      <% } %>

      <a
        href="/web/traffic/test?page=<%= totalPages %>"
        class="social-search-page-button social-search-page-number"
        aria-label="Page <%= totalPages %>"
      >
        <%= totalPages %>
      </a>

    <% } %>

  </div>


  <!-- NEXT -->

  <% if (page < totalPages) { %>

    <a
      href="/web/traffic/test?page=<%= page + 1 %>"
      class="social-search-page-button social-search-page-next"
    >
      Next →
    </a>

  <% } else { %>

    <span
      class="social-search-page-button social-search-page-next disabled"
    >
      Next →
    </span>

  <% } %>


  <!-- LAST -->

  <% if (page < totalPages) { %>

    <a
      href="/web/traffic/test?page=<%= totalPages %>"
      class="social-search-page-button social-search-page-next"
    >
      Last →
    </a>

  <% } else { %>

    <span
      class="social-search-page-button social-search-page-next disabled"
    >
      Last →
    </span>

  <% } %>

</nav>
</section>
   <!-- PAGINATION -->
   <!--👇👆👆👇👆👇--> 
  <!---->
  <!--👇👆👆👇👆👇-->
</main>


<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

// (data):object receive from front js
socket.on("new-visitor", (data) => {

    const table = document.getElementById("list");

    table.innerHTML =
    `
    <tr>
        <td>NEW</td>
        <td>${data.ip || ""}</td>
        <td>${data.page}</td>
        <td>${data.time}</td> 
    </tr>
    `
    + table.innerHTML;

});

</script>
<script>

function toggleAll(source) {
  const checkboxes = document.querySelectorAll(".visitor-checkbox");

  checkboxes.forEach(checkbox => {
    checkbox.checked = source.checked;
  });
}

function confirmBulkDelete() {
  const selected = document.querySelectorAll(
    ".visitor-checkbox:checked"
  );

  if (selected.length === 0) {
    alert("Please select at least one visitor.");
    return false;
  }

  return confirm(
    `Delete ${selected.length} selected visitor record(s)?`
  );
}

</script>
<!-- Link external JS end -->
