<%- include("partials/header.ejs") %>

<main class="container">
 <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>
  <section class="py-5 bg-light border border-black mt-4 mb-4">

    <h2>Live Recordings</h2>

    <div class="container-fluid">

      <% if (broadcasts.length > 0) { %>

        <% broadcasts.forEach(broadcast => { %>

          <div class="border border-dark rounded p-3 mb-3 bg-white">

            <h3>
              <%= broadcast.title || "Live Broadcast" %>
            </h3>

            <p>
              Mode:
              <%= broadcast.mode || "" %>
            </p>

            <p>
              Status:
              <%= broadcast.status || "" %>
            </p>

            <% if (broadcast.started_at) { %>
              <p>
                Started:
                <%= broadcast.started_at %>
              </p>
            <% } %>

            <% if (broadcast.ended_at) { %>
              <p>
                Ended:
                <%= broadcast.ended_at %>
              </p>
            <% } %>
             <% if (broadcast.id) { %>
              <p>
                Broadcast ID:
                <%= broadcast.id %>
              </p>
            <% } %>
   
            <a
              href="/report/live/<%= broadcast.id %>/playback"
              class="btn btn-primary"
            >
              Play Recording
            </a>
            <a
  href="/report/live/<%= broadcast.id %>/download"
  class="btn btn-success"
>
  ⬇️ Download Recording
</a>

<a
  href="/report/live/<%= broadcast.id %>/delete"
  class="btn btn-danger"
  onclick="return confirm('Are you sure you want to delete this recording?');"
>
  🗑️ Delete Recording
</a>



          </div>

        <% }) %>
 
      <% } else { %>

        <p>No live recordings found.</p>

      <% } %>

    </div>

  </section>
  <section class="py-5 bg-light border border-black mt-4 mb-4">
 <!--No if outside one or any record: page still shown-->

    <nav class="social-pagination" aria-label="Live report pagination">

      <% if (page > 1) { %>

        <a
          href="/report/live?page=<%= page - 1 %>"
          class="social-page-btn"
        >
          ← Previous
        </a>

      <% } else { %>

        <span class="social-page-btn disabled">
          ← Previous
        </span>

      <% } %>


      <div class="social-page-numbers">

        <% for (let i = 1; i <= totalPages; i++) { %>

          <% if (i === page) { %>

            <span class="social-page-number active">
              <%= i %>
            </span>

          <% } else { %>

            <a
              href="/report/live?page=<%= i %>"
              class="social-page-number"
            >
              <%= i %>
            </a>

          <% } %>

        <% } %>

      </div>


      <% if (page < totalPages) { %>

        <a
          href="/report/live?page=<%= page + 1 %>"
          class="social-page-btn"
        >
          Next →
        </a>

      <% } else { %>

        <span class="social-page-btn disabled">
          Next →
        </span>

      <% } %>

    </nav>

   
</section>

<section class="py-5 bg-light border border-black mt-4 mb-4">

</section>
<section class="py-5 bg-light border border-black mt-4 mb-4"></section>
</main>


<%- include("partials/footer.ejs") %>
 