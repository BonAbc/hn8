          title="Email">
    <span class="reaction-icon">✉️</span>
    <span class="reaction-count"><%= post.reactions?.email || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="smile"
          title="Smile">
    <span class="reaction-icon">🙂</span>
    <span class="reaction-count"><%= post.reactions?.smile || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="bell"
          title="Bell">
    <span class="reaction-icon">🔔</span>
    <span class="reaction-count"><%= post.reactions?.bell || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="trophy"
          title="Trophy">
    <span class="reaction-icon">🏆</span>
    <span class="reaction-count"><%= post.reactions?.trophy || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="victory"
          title="Victory">
    <span class="reaction-icon">✌️</span>
    <span class="reaction-count"><%= post.reactions?.victory || 0 %></span>
  </button>
</div>

<!---->
<!---->
        </article>

        <% if (index < posts.length - 1) { %>
          <hr>
        <% } %>

      <% }) %>

    <% } else { %>

      <p class="social-public-empty">
        No public posts available for reactions.
      </p>

    <% } %>

  </div>

</section>



<!-- =========================================================
     PAGINATION
========================================================== -->

<section class="py-5 bg-light border border-black mt-4 mb-4">

  <div class="public-post-pagination">

    <!-- PREVIOUS -->

    <% if (pagination && pagination.hasPrevious) { %>

      <a
        href="/public/post/connect?page=<%= pagination.previousPage %>"
        class="public-post-pagination__nav"
      >
        ← Previous
      </a>

    <% } else { %>

      <span
        class="public-post-pagination__nav public-post-pagination__disabled"
      >
        ← Previous
      </span>

    <% } %>


    <!-- PAGE NUMBERS -->

    <% if (pagination && pagination.totalPages > 0) { %>

      <% for (
        let i = 1;
        i <= pagination.totalPages;
        i++
      ) { %>

        <a
          href="/public/post/connect?page=<%= i %>"
          class="public-post-pagination__page <%= i === pagination.page
            ? 'public-post-pagination__active'
            : ''
          %>"
        >
          <%= i %>
        </a>

      <% } %>

    <% } else { %>

      <span class="public-post-pagination__page public-post-pagination__active">
        1
      </span>

    <% } %>


    <!-- NEXT -->

    <% if (pagination && pagination.hasNext) { %>

      <a
        href="/public/post/connect?page=<%= pagination.nextPage %>"
        class="public-post-pagination__nav"
      >
        Next →
      </a>

    <% } else { %>

      <span
        class="public-post-pagination__nav public-post-pagination__disabled"
      >
        Next →
      </span>

    <% } %> 

  </div>

</section>


  <!---->
  

  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>
<script src="/js/socialpublicconnect.js"></script> 

<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
  