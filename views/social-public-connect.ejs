    <span class="reaction-count"><%= post.reactions?.call || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="website"
          title="Website">
    <span class="reaction-icon">🌐</span>
    <span class="reaction-count"><%= post.reactions?.website || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
