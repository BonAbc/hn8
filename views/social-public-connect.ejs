  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="heart"
          title="Heart">
    <span class="reaction-icon">❤️</span>
    <span class="reaction-count"><%= post.reactions?.heart || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="horse"
          title="Horse">
    <span class="reaction-icon">🐴</span>
    <span class="reaction-count"><%= post.reactions?.horse || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="rose"
          title="Rose">
    <span class="reaction-icon">🌹</span>
    <span class="reaction-count"><%= post.reactions?.rose || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="fly"
          title="Fly">
    <span class="reaction-icon">🪰</span>
    <span class="reaction-count"><%= post.reactions?.fly || 0 %></span>
  </button>

  <button type="button"
          class="social-public-reaction-btn"
          data-reaction="call"
