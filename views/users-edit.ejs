 <%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
 
<form>
  <label for="date">Date:</label>
  <input
    type="date"
    id="date"
    name="date"
    value="<%= defaultDate %>"
  />
</form>

<!---->
<!---->

<h2 id="hm">User Management</h2>

 
 
<section class="py-5 bg-light border border-black mt-4 mb-4">

  <div class="container-fluid">

    <h2>  Edit User</h2>

    <div class="row justify-content-center mt-4">

      <div class="col-12 col-md-10 col-lg-8">

        <div class="card border rounded shadow-sm">

          <div class="card-body">

            <h4 class="mb-4">
              Edit User #<%= user.id %>
            </h4>

           <form
  action="/user/<%= user.id %>?_method=PATCH"
  method="POST"
>

  <!-- Email -->
  <div class="mb-3">

    <label for="email" class="form-label">
      Email
    </label>

    <input
      type="text"
      id="email"
      name="email"
      class="form-control"
      value="<%= user.email || '' %>"
    />

  </div>


  <!-- Group ID -->
  <div class="mb-3">

    <label for="group_id" class="form-label">
      Group ID
    </label>

    <input
      type="number"
      id="group_id"
      name="group_id"
      class="form-control"
      value="<%= user.group_id ?? '' %>"
    />

  </div>


  <div class="mt-4">

    <button
      type="submit"
      class="btn btn-primary w-auto"
    >
      Save Changes
    </button>

    <br><br>

    <a
      href="/users/loveme"
      class="btn btn-secondary w-auto"
    >
      Cancel
    </a>

  </div>

</form>
<hr>
<hr>
<h6>All below is for information. No Update</h6>
<h2>When change user name, reset authenticator > Admin only</h2>
            <!-- Active -->
            <div class="form-check mb-3">

              <input
                type="checkbox"
                id="is_active"
                name="is_active"
                class="form-check-input"
                <%= user.is_active ? "checked" : "" %>
              />

              <label
                for="i_active"
                class="form-check-label"
              >
                Active
              </label>

            </div>


            <!-- 2FA Enabled -->
            <div class="form-check mb-3">

              <input
                type="checkbox"
                id="two_factor_enabled"
                name="two_factor_enabled"
                class="form-check-input"
                <%= user.two_factor_enabled ? "checked" : "" %>
              />

              <label
                for="two_factor_enabled"
                class="form-check-label"
              >
                Two-Factor Authentication Enabled
              </label>

            </div>


            <!-- Password Change Approved -->
            <div class="form-check mb-3">

              <input
                type="checkbox"
                id="pw_change_approved"
                name="pw_change_approved"
                class="form-check-input"
                <%= user.pw_change_approved ? "checked" : "" %>
              />

              <label
                for="pw_change_approved"
                class="form-check-label"
              >
                Password Change Approved
              </label>

            </div>


            <hr class="my-4">



            <h5>Security Information</h5>
            

            <div class="mb-3">

              <label
                for="failed_2fa_attempts"
                class="form-label"
              >
                Failed 2FA Attempts
              </label>

              <input
                type="text"
                id="failed_2fa_attempts"
                class="form-control"
                value="<%= user.failed_2fa_attempts ?? 0 %>"
                readonly
              />

            </div>


            <div class="mb-3">

              <label
                for="two_fa_lock_until"
                class="form-label"
              >
                2FA Lock Until
              </label>

              <input
                type="text"
                id="two_fa_lock_until"
                class="form-control"
                value="<%= user.two_fa_lock_until || 'Not locked' %>"
                readonly
              />

            </div>   
                 
            <hr class="my-4">       

            <h5>Account Information</h5>

            <div class="mb-3">

              <label
                for="created_date"
                class="form-label"
              >
                Created Date
              </label>

              <input
                type="text"
                id="created_date"
                class="form-control"
                value="<%= user.created_date || '' %>"
                readonly
              />

            </div>

 
            <div class="mb-3">

              <label
                for="created_at_alt"
                class="form-label"
              >
                Created At Alt
              </label>

              <input
                type="text"
                id="created_at_alt"
                class="form-control"
                value="<%= user.created_at_alt || '' %>"
                readonly
              />

            </div>
  
          </div>

        </div>

      </div>

    </div>

  </div>

</section>




<section class="py-5 bg-light border border-black mt-4 mb-4"></section>








</main>





<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
