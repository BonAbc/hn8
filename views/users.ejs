  <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid">
        <h2>User Management</h2>
  <!-- Group ID Filter -->
   <form method="GET" action="/users/loveme" class="d-flex align-items-center gap-2">

  <label for="group_id" class="fw-bold">
    Filter by Group ID:
  </label>

  <select
    name="group_id"
    id="group_id"
    class="form-select w-auto"
  >
    <option value="">All Groups</option>

    <% groups.forEach(group => { %>

      <option
        value="<%= group.group_id %>"
        <%= String(groupId) === String(group.group_id) ? "selected" : "" %>
      >
        Group <%= group.group_id %>
      </option>

    <% }) %>
  </select>

  <button type="submit" class="btn btn-primary">
    Filter
  </button>

</form>
    <br>
<!-- Desktop Table -->
<div class="d-none d-md-block table-responsive">
 

  <table class="table table-striped table-hover user-table">

  <thead>
    <tr>
      <th>Id</th>
      <th>Email</th>
      <th>Status</th>
      <th>Group ID</th>
      <th>Edit</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>

    <% users.forEach(user => { %>

      <tr>

        <td>
          <%= user.id %>
        </td>

        <td>
          <%= user.email %>
        </td>
 
        <td>
          <% if (user.is_active) { %>
            Active
          <% } else { %>
            Disabled
          <% } %>
        </td>
         <td>
          <%= user.group_id %>
        </td>
 

        <!-- Edit column -->
        <td>
          <a
            href="/user/<%= user.id %>/edit"
            class="btn btn-primary"
          >
            Edit
          </a>
        </td>
 
        <!-- Action column -->
        <td>

          <% if (user.is_active) { %>

            <form
              action="/user/<%= user.id %>?_method=DELETE"
              method="POST"
              class="action-form"
            >
              <button
                type="button"
                class="btn btn-danger confirm-btn"
                data-bs-toggle="modal"
                data-bs-target="#confirmModal"
                data-action="disable"
              >
                Disable User
              </button>
            </form>

          <% } else { %>

            <form
              action="/user/<%= user.id %>?_method=PUT"
              method="POST"
              class="action-form"
            >
              <button
                type="button"
                class="btn btn-success confirm-btn"
                data-bs-toggle="modal"
                data-bs-target="#confirmModal"
                data-action="reactivate"
              >
                Reactivate User
              </button>
            </form>

          <% } %>

        </td>

      </tr>

    <% }) %>

  </tbody>

</table>


<!-- Pagination -->
<nav aria-label="Users pagination" class="mt-4">
  <ul class="pagination justify-content-center">

    <!-- Previous -->
    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
      <a
        class="page-link"
        href="/users/loveme?page=<%= currentPage - 1 %><%= groupId ? '&group_id=' + groupId : '' %>"
      >
        Previous
      </a>
    </li>


    <!-- Page Numbers -->
    <% for (let i = 1; i <= totalPages; i++) { %>

      <li class="page-item <%= currentPage === i ? 'active' : '' %>">

        <a
          class="page-link"
          href="/users/loveme?page=<%= i %><%= groupId ? '&group_id=' + groupId : '' %>"
        >
          <%= i %>
        </a>

      </li>

    <% } %>


    <!-- Next -->
    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
      <a
        class="page-link"
        href="/users/loveme?page=<%= currentPage + 1 %><%= groupId ? '&group_id=' + groupId : '' %>"
      >
        Next
      </a>
    </li>

  </ul>
</nav>

</div>

<!-- Confirm Modal -->



  <div class="modal fade" id="confirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">
          Confirm Action
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal">
        </button>
      </div>

      <div class="modal-body" id="confirmMessage">
        Are you sure?
      </div>

      <div class="modal-footer">

        <button
          type="button"
          class="btn btn-secondary"
          data-bs-dismiss="modal">
          Cancel
        </button>

        <button
          type="button"
          class="btn btn-primary"
          id="confirmActionBtn">
          Yes
        </button>

      </div>

    </div>
  </div>
</div>
