<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>

  <!---->
  <h2 id="hm">User Management</h2> 
 

  <!--👇👆👆👇👆👇--> 
  <!---->
  <!--👇👆👆👇👆👇-->
    
   <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid">
  <!-- Group ID Filter -->
   <!--👇👆👆👇👆👇--> 
  <!----> 
  <!--👇👆👆👇👆👇-->
  <!--Form-->  
  <form method="GET" action="/users/loveme" class="row g-2 align-items-end">

  <div class="col-12 col-md-auto">
    <label for="group_id" class="form-label fw-bold mb-1">
      Filter by Group ID:
    </label>
 
    <select
      name="group_id"
      id="group_id"
      class="form-select"
    >
      <option value="">All Groups</option>

      <% groups.forEach(group => { %>
        <option
          value="<%= group.group_id %>"
          <%= String(groupId || "") === String(group.group_id) ? "selected" : "" %>
        >
          Group <%= group.group_id %>
        </option>
      <% }) %>
    </select>
  </div>

  <div class="col-12 col-md-auto">
    <button type="submit" class="btn btn-primary w-100">
      Filter
    </button>
  </div>
  <div id="hm">Total Users: <%= userTotal %></div>

</form>
 </div>
</section>
 <!--Form-->  
      <!--👇👆👆👇👆👇--> 
  <!---->
  <!--👇👆👆👇👆👇-->
<!-- Desktop Table -->
<div class="table-responsive">
  <table class="table table-striped table-hover user-table">


  <thead>
    <tr>
      <th>Id</th>
      <th>Email</th>
      <th>Status</th>
      <th>Group ID</th>
      <th>Edit</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>

    <% users.forEach(user => { %>

      <tr>

        <td>
          <%= user.id %>
        </td>

        <td>
          <%= user.email %>
        </td>
 
        <td>
          <% if (user.is_active) { %>
            Active
          <% } else { %>
            Disabled
          <% } %>
        </td>
         <td>
          <%= user.group_id %>
        </td>
 
 
        <!-- Edit column -->
        <td>
          <a
            href="/user/<%= user.id %>/edit"
            class="btn btn-primary"
          >
            Edit
          </a>
        </td>

        <!-- Action column -->
        <td>

          <% if (user.is_active) { %>

            <form
              action="/user/<%= user.id %>?_method=DELETE"
              method="POST"
              class="action-form"
            >
              <button
                type="button"
                class="btn btn-danger confirm-btn"
                data-bs-toggle="modal"
                data-bs-target="#confirmModal"
                data-action="disable"
              >
                Disable User
              </button>
            </form>

          <% } else { %>

            <form
              action="/user/<%= user.id %>?_method=PUT"
              method="POST"
              class="action-form"
            >
              <button
                type="button"
                class="btn btn-success confirm-btn"
                data-bs-toggle="modal"
                data-bs-target="#confirmModal"
                data-action="reactivate"
              >
                Reactivate User
              </button>
            </form>

          <% } %>

        </td>

      </tr>

    <% }) %>

  </tbody>

</table>




</div>

<!-- Desktop Table -->
     <!--👇👆👆👇👆👇--> 
  <!---->
  <!--👇👆👆👇👆👇-->
<!-- Confirm Modal -->



  <div class="modal fade" id="confirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">
          Confirm Action
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal">
        </button>
      </div>

      <div class="modal-body" id="confirmMessage">
        Are you sure?
      </div>

      <div class="modal-footer">

        <button
          type="button"
          class="btn btn-secondary"
          data-bs-dismiss="modal">
          Cancel
        </button>

        <button
          type="button"
          class="btn btn-primary"
          id="confirmActionBtn">
          Yes
        </button>

      </div>

    </div>
  </div>
</div>
<!---->
<% if (message) { %>
<div class="modal fade" id="successModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">
          Success
        </h5>
        <button 
          type="button" 
          class="btn-close" 
          data-bs-dismiss="modal">
        </button>
      </div>

      <div class="modal-body">

        <% if (message === "disabled") { %>
          User disabled successfully ✅
        <% } %>

        <% if (message === "reactivated") { %>
          User reactivated successfully ✅
        <% } %>

      </div>

      <div class="modal-footer">
        <button 
          type="button" 
          class="btn btn-success" 
          data-bs-dismiss="modal">
          OK
        </button>
      </div>

    </div>
  </div>
 
</div>
 <% } %>
    </div>
  </section>
 
   <section class="py-5 bg-light border border-black mt-4 mb-4"> 
   
 <!-- Pagination -->
<nav
  class="social-search-pagination"
  aria-label="Users pagination"
>

  <!-- PREVIOUS -->

  <% if (currentPage > 1) { %>

    <a
      href="/users/loveme?page=<%= currentPage - 1 %><%= groupId ? '&group_id=' + groupId : '' %>"
      class="social-search-page-button social-search-page-prev"
    >
      ← Previous
    </a>

  <% } else { %>

    <span
      class="social-search-page-button social-search-page-prev disabled"
    >
      ← Previous
    </span>

  <% } %>


  <!-- PAGE NUMBERS -->

  <div class="social-search-page-numbers">

    <% for (let i = 1; i <= totalPages; i++) { %>

      <a
        href="/users/loveme?page=<%= i %><%= groupId ? '&group_id=' + groupId : '' %>"
        class="social-search-page-button social-search-page-number <%= currentPage === i ? 'active' : '' %>"
        aria-label="Page <%= i %>"
        <%= currentPage === i ? 'aria-current="page"' : '' %>
      >
        <%= i %>
      </a>

    <% } %>

  </div>


  <!-- NEXT -->

  <% if (currentPage < totalPages) { %>

    <a
      href="/users/loveme?page=<%= currentPage + 1 %><%= groupId ? '&group_id=' + groupId : '' %>"
      class="social-search-page-button social-search-page-next"
    >
      Next →
    </a>

  <% } else { %>

    <span
      class="social-search-page-button social-search-page-next disabled"
    >
      Next →
    </span>

  <% } %>
 
</nav>
<!-- Pagination -->
  </section>
  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>

  <script src="/js/users.js"></script>



<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->