<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>

  <!---->
  <!---->
  <h2 id="hm">Hoa Mai</h2>
  <!--👇👆👆👇👆👇-->
  <!---->
<section class="py-5 bg-light border border-black mt-4 mb-4">

  <div class="container">

    <h2 class="mb-4">
      📥 Social Interact Downloads
    </h2>

    <p>
      <strong>Admin only</strong>
      — Download files attached to social posts.
    </p>

    <hr>

    <% if (!posts || posts.length === 0) { %>

      <div class="alert alert-info">
        No social posts with files were found.
      </div>

    <% } else { %>

      <% posts.forEach((post) => { %>

        <article class="social-download-post mb-4">

          <div class="social-download-post-header">

            <strong>
              <%= post.email %>
            </strong>

            <small>
              <%= post.createdAt
                ? new Date(post.createdAt).toLocaleString()
                : ""
              %>
            </small>

          </div>


          <div class="social-download-content mt-2">

            <%= post.content || "(No text)" %>

          </div>


          <div class="social-download-files mt-3">

            <% post.media.forEach((file) => { %>

              <div
                class="social-download-file d-flex align-items-center justify-content-between border p-3 mb-2 bg-white"
              >

                <div>

                  <% if (
                    file.mimeType &&
                    file.mimeType.startsWith("image/")
                  ) { %>

                    🖼️

                  <% } else if (
                    file.mimeType === "application/pdf"
                  ) { %>

                    📄

                  <% } else { %>

                    📎

                  <% } %>

                  <strong>
                    <%= file.fileName || "Unnamed file" %>
                  </strong>

                </div>


                <a
                  href="/social-admin-downloads/file/<%= file.id %>"
                  class="social-download-button"
                >
                  ⬇️ Download
                </a>

              </div>

            <% }) %>

          </div>

        </article>

      <% }) %>

    <% } %>

  </div>
<% if (totalPages > 1) { %>

  <nav
    class="social-pagination"
    aria-label="Social download pagination"
  >

    <% if (page > 1) { %>

      <a
        href="/social-admin-downloads?page=<%= page - 1 %>"
        class="social-page-btn"
      >
        ← Previous
      </a>

    <% } else { %>

      <span class="social-page-btn disabled">
        ← Previous
      </span>

    <% } %>


    <div class="social-page-numbers">

      <% for (let i = 1; i <= totalPages; i++) { %>

        <% if (i === page) { %>

          <span class="social-page-number active">
            <%= i %>
          </span>

        <% } else { %>

          <a
            href="/social-admin-downloads?page=<%= i %>"
            class="social-page-number"
          >
            <%= i %>
          </a>

        <% } %>

      <% } %>

    </div>


    <% if (page < totalPages) { %>

      <a
        href="/social-admin-downloads?page=<%= page + 1 %>"
        class="social-page-btn"
      >
        Next →
      </a>

    <% } else { %>

      <span class="social-page-btn disabled">
        Next →
      </span>

    <% } %>

  </nav>

<% } %>
</section>
  <!--👇👆👆👇👆👇-->
  <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid"></div>
  </section>
 
  <!--👇👆👆👇👆👇-->
 
</main>

