<%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <div class="date-row">
    <form>
      <label for="date">Date:</label>
      <input type="date" id="date" name="date" data-local-today />
    </form>

    <div class="clock" id="clock">
      <span class="number n12">12</span>
      <span class="number n1">1</span>
      <span class="number n2">2</span>
      <span class="number n3">3</span>
      <span class="number n4">4</span>
      <span class="number n5">5</span>
      <span class="number n6">6</span>
      <span class="number n7">7</span>
      <span class="number n8">8</span>
      <span class="number n9">9</span>
      <span class="number n10">10</span>
      <span class="number n11">11</span>

      <div class="hand hour" id="hour"></div>
      <div class="hand minute" id="minute"></div>
      <div class="hand second" id="second"></div>
      <div class="clock-dot"></div>
    </div>
  </div>

  <!---->
  <h2 id="hm">Interest Calculator</h2>

  <section class="py-4 px-3 bg-light border border-black rounded mt-4 mb-4">
    <h5 class="mb-3">Mortgage Interest Rate Calculator</h5>

    <form id="mortgageCalculatorForm">
      <div class="row g-3">
        <div class="col-md-6">
          <label for="financeAmount" class="form-label"
            >Finance Amount ($)</label
          >
          <input
            type="number"
            id="financeAmount"
            class="form-control"
            min="0.01"
            step="0.01"
            placeholder="Finance Amount"
            required
          />
        </div>

        <div class="col-md-6">
          <label for="numberOfPayments" class="form-label"
            >Number of Payments</label
          >
          <input
            type="number"
            id="numberOfPayments"
            class="form-control"
            min="1"
            step="1"
            placeholder="Number of Payments"
            required
          />
        </div>

        <div class="col-md-6">
          <label for="constantPayment" class="form-label">
            Constant Payment Amount ($)
          </label>
          <input
            type="number"
            id="constantPayment"
            class="form-control"
            min="0.001"
            step="0.001"
            placeholder="Constant Payment Amount"
            required
          />
        </div>

        <div class="col-md-6">
          <label for="totalPayment" class="form-label">Total Payment ($)</label>
          <input
            type="text"
            id="totalPayment"
            class="form-control"
            placeholder="Calculated automatically"
            readonly
          />
        </div>

        <div class="col-md-6">
          <label for="paymentStartDate" class="form-label">
            Payment Start Date
          </label>
          <input
            type="date"
            id="paymentStartDate"
            class="form-control"
            data-local-today
            required
          />
        </div>

        <div class="col-md-6">
          <label for="paymentEndDate" class="form-label">
            Payment End Date (Auto)
          </label>
          <input
            type="date"
            id="paymentEndDate"
            class="form-control"
            readonly
          />
        </div>

        <div class="col-md-6">
          <label for="annualInterestRate" class="form-label">
            Annual Percentage Interest Rate (%)
          </label>
          <input
            type="text"
            id="annualInterestRate"
            class="form-control"
            placeholder="Calculated automatically"
            readonly
          />
        </div>
      </div>

      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Calculate</button>
        <button
          type="reset"
          id="resetMortgageCalculator"
          class="btn btn-secondary ms-2"
        >
          Clear
        </button>
      </div>
      <br />
      <h6>***For informational purposes only. All numbers are estimates.***</h6>
      <div
        id="mortgageCalculatorMessage"
        class="mt-3"
        role="status"
        aria-live="polite"
      ></div>
    </form>
  </section>

  <section class="py-4 px-3 bg-light border border-black rounded mt-4 mb-4">
    <h5 class="mb-3">Amortization Schedule</h5>

    <div class="amortization-table-wrapper table-responsive">
      <table class="table table-bordered table-striped amortization-table">
        <thead>
          <tr>
            <th>Period</th>
            <th>Year</th>
            <th>Payment Date</th>
            <th>Beginning Balance</th>
            <th>Total Payment</th>
            <th>Interest Paid</th>
            <th>Principal Paid</th>
            <th>Unpaid Interest</th>
            <th>Ending Balance</th>
            <th>Late Fee</th>
            <th>Other Charges</th>
          </tr>
        </thead>

        <tbody id="amortizationBody">
          <tr>
            <td colspan="11" class="text-center">
              Enter your loan information and click Calculate.
            </td>
          </tr>
        </tbody>

        <tfoot id="amortizationFooter"></tfoot>
      </table>
    </div>
  </section>
  <br />
  <section class="py-4 px-3 bg-light border border-black rounded mt-4 mb-4">
    <a href="/mortgage"> Mortgage Calculator </a>
  </section>

  <!--Refer to index.ejs how to include header and footer.ejs-->
</main>
<script src="https://cdn.jsdelivr.net/npm/luxon@3/build/global/luxon.min.js"></script>
<script src="/js/clocklocal.js"></script>
<script src="/js/local-date.js"></script>
<script src="/js/mortgage-interest.js" defer></script>
<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
