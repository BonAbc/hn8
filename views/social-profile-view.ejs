 <%- include("partials/header.ejs") %>
<!--Remember this include when add a new page-->
<main class="container">
  <!--main should move to main page-->
  <!---->
  <form>
    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>

  <!---->
  <h2 id="hm">Professional Profile</h2>

   
    <section class="py-5 bg-light border border-black mt-4 mb-4">

  <div style="background:#fff3cd;padding:10px;">

    <% if (profile) { %>

  <!-- Professional information -->
  <div style="margin-top:15px; margin-bottom:15px;">

    <div>
      <strong>Name:</strong>
      <%= currentUserEmail %>
    </div> 
 
 
    <% if (profile.emailpr) { %>
      <div>
        <strong>Email:</strong>
        <%= profile.emailpr %>
      </div>
    <% } %>
     <% if (profile.phone) { %>
      <div>
        <strong>Phone:</strong>
        <%= profile.phone %>
      </div>
    <% } %>
  
  </div> 
  <!-- Profile -->
  <div>

    <% if (profile.avatar) { %>
      <img
        src="<%= profile.avatar %>"
        alt="Profile Photo"
        style="
          width:105px;
          height:105px;
          border-radius:50%;
          object-fit:cover;
          object-position:center;
          display:block;
          margin:0 auto 15px auto;
        "
      />
    <% } %>   

 <!-- Website -->
      <div>
  <strong>Website:</strong>

  <% if (profile.website) { 
       let website = profile.website.trim();

       // Add protocol if missing
       if (!/^https?:\/\//i.test(website)) {
         website = 'https://' + website;
       }
  %>

    <a
      href="<%= website %>"
      target="_blank"
      rel="noopener noreferrer"
    >
      <%= profile.website %>
    </a>

  <% } else { %>
    Not available
  <% } %>
</div>

      
 <!-- Website -->
     <% if (profile.slogan) { %>
      <div>
        <strong>Tagline:</strong>
        <%= profile.slogan %>
      </div>
    <% } %> 

   <div>
  <strong>Address:</strong>
  <%= profile.address || '--------------------' %>
</div>
  </div> 

<% } else { %>

  <div>
    No professional profile has been created yet.
  </div>

<% } %>


  </div>

</section>
 


</main>

<%- include("partials/footer.ejs") %><!--Remember this include when add a new page-->
