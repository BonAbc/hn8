function canDownloadSocialMedia(userEmail) {
  const downloadAdminEmails = (process.env.SPECIAL_ADMIN_EMAILS || "")
    .split(",")
    .map((email) => email.trim().toLowerCase())
    .filter(Boolean);

  return downloadAdminEmails.includes(
    String(userEmail || "")
      .trim()
      .toLowerCase(),
  );
}
