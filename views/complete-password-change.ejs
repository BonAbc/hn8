    <label for="date">Date:</label>
    <input type="date" id="date" name="date" value="<%= defaultDate %>" />
  </form>

  <!---->  
  <!---->  
  <h2 id="hm">Hoa Mai</h2>
  <!--👇👆👆👇👆👇--> 
  <!---->
  <% if (message) { %>
  <p style="color: green;"><%= message %></p>
<% } %>
  <!--👇👆👆👇👆👇-->
   <section class="py-5 bg-light border border-black mt-4 mb-4">
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <!-- Card wrapper for form -->
        <div class="card shadow-sm">
          <div class="card-body">
            <h4 class="card-title text-center mb-4">Change Password</h4>

            <!-- Show message if exists -->

            <!---->
              <% if (message) { %>
  <p style="color: green;"><%= message %></p>
<% } %>
            <!---->
            <!-- Show message if exists -->
            <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-info" id="message"><%= message %></div>
            <% } %>

            <!---->
            <!-- Form for changing/resetting password -->
            <form action="/complete-password-change" method="POST">
              <!-- Email field (forgot password) -->
              
              <!-- New password -->
              <div class="mb-3">
                <label for="newPassword" class="form-label fw-semibold"
                  >New Password</label
                >

                <div class="custom-input-group">
                  <input
                    type="password"
                    class="form-control"
                    id="newPassword"
                    name="newPassword"
                    required
                    autocomplete="current-password"
                  />
                  <button
                    type="button"
                    id="togglPassword"
                    class="toggle-btn"
                    aria-label="Toggle password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>

              <!-- Confirm password -->
              <div class="mb-3">
                <label for="confirmPassword" class="form-label"
                  >Confirm Password</label
                >
                <div class="custom-input-group">
                  <!--Check CSS make eye on the same line 👆-->
                  <input
                    type="password"
                    class="form-control"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                  />
                  <button
                    type="button"
                    id="togglePassword"
                    class="toggle-btn"
                    aria-label="Toggle password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>

              <button type="submit" class="btn btn-primary w-100">
                Confirm Password Change
              </button>
            </form>

            <div class="mt-3 text-center">
              <a href="/login">Back to Login</a>
            </div>
          </div>
        </div> 
      </div>
    </div>
  </div> 
  </section>
  <!--👇👆👆👇👆👇-->
  <section class="py-5 bg-light border border-black mt-4 mb-4"></section>
  <section class="py-5 bg-light border border-black mt-4 mb-4">
    <div class="container-fluid">
      <!--👇👆👆👇👆👇-->
      <button type="submit" class="btn btn-primary w-auto">Good Format</button>
      <!--👇👆👆👇👆👇-->
    </div>
  </section>
