<section class="py-5 bg-light border border-black mt-4 mb-4">
  <!-- Main login form container --> 
   <div class="container-fluid">
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-sm-6 col-md-5 col-lg-4"> 
        <div class="card border rounded shadow-sm"> 
          <div
            class="card-body d-flex flex-column justify-content-center"
            style="min-height: 400px"
          >
          <!--👌👌👌👌👌 Line 951 js > 2fa required: no route in the header for enable.ejs and verify-2fa.ejs👌👌👌👌👌-->
            <!--SOmething👌👌👌👌👌 need to require adMin through 2FA-->
           
            <h4 class="mb-2 fw-bold text-center">Log in</h4>
            <% if (message && message.length > 0) { %> <%
            message.forEach(function(msg) { %>
            <div class="alert alert-danger text-center flash-message">
              <%= msg %>
            </div>
            <% }) %> <% } %>
<!--Here is in Login app.get Page 👌👌 Refer to Line 640 js Use session and authenticate 👌👌👌👌👌-->
            <form action="/login" method="POST" autocomplete="off">
              <div class="mb-3">
                <label for="username" class="form-label fw-semibold">
                  Username
                </label>
    
                <input 
                  type="text"
                  id="username"
                  name="username"
                  class="form-control rounded-pill border-dark"
                  required
                  autocomplete="username"
                />
              </div>

              <div class="mb-3">
                <label for="password" class="form-label fw-semibold"> 
                  Password
                </label>

                <div class="custom-input-group">
                  <input 
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    required
                    autocomplete="current-password"
                  />
                  <button
                    type="button"
                    id="togglePassword"
                    class="toggle-btn"
                    aria-label="Toggle password visibility"
                  >
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>

              <div class="d-grid mb-3">
                <button
                  type="submit"
                  class="btn btn-success rounded-pill fw-bold"
                >
                  Log in
                </button> 
              </div> 
 
              <div class="text-center">
                <a class="text-decoration-none" href="/chapw">
                  Update Password
                </a>
              </div> 
              
              
            </form>
            
<!--Here is in Login app.get Page 👌👌 Refer to Line 640 js Use session and authenticate 👌👌👌👌👌-->
          </div>
        </div>
      </div> 
    </div>
  </div>
  <div class="text-center">
                <h6> New User > Please contact Admin @ hn@hieuncpa.com/847-208-9053 </h6>
              </div> 
  </div>            
</section>
